generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(uuid())
  cognitoId             String?        @unique @map("cognito_id")
  email                 String         @unique
  firstName             String         @map("first_name")
  lastName              String         @map("last_name")
  username              String?        @unique
  avatarUrl             String?        @map("avatar_url")
  university            String?
  course                String?
  yearOfStudy           Int?           @map("year_of_study")
  graduationYear        Int?           @map("graduation_year")
  bio                   String?
  isVerified            Boolean        @default(false) @map("is_verified")
  isSeller              Boolean        @default(false) @map("is_seller")
  sellerBio             String?        @map("seller_bio")
  hasCompletedOnboarding Boolean       @default(false) @map("has_completed_onboarding")
  createdAt             DateTime       @default(now()) @map("created_at")
  answers         Answer[]
  conversations1  Conversation[] @relation("Participant1")
  conversations2  Conversation[] @relation("Participant2")
  items           Item[]         @relation("Seller")
  mentorProfile   MentorProfile?
  messages        Message[]
  notifications   Notification[]
  questions       Question[]
  reviewsReceived Review[]       @relation("Reviewee")
  reviewsGiven    Review[]       @relation("Reviewer")
  savedItems      SavedItem[]

  @@map("users")
}

model Item {
  id                  String         @id @default(uuid())
  sellerId            String         @map("seller_id")
  title               String
  description         String?
  price               Decimal        @db.Decimal(10, 2)
  category            Category
  condition           Condition
  status              ItemStatus     @default(ACTIVE)
  images              String[]
  courseCode          String?        @map("course_code")
  university          String?
  views               Int            @default(0)
  saves               Int            @default(0)
  isMentorRecommended Boolean        @default(false) @map("is_mentor_recommended")
  createdAt           DateTime       @default(now()) @map("created_at")
  conversations       Conversation[]
  seller              User           @relation("Seller", fields: [sellerId], references: [id])
  reviews             Review[]
  savedBy             SavedItem[]

  @@map("items")
}

model MentorProfile {
  id             String       @id @default(uuid())
  userId         String       @unique @map("user_id")
  bio            String?
  expertise      String[]
  endorsements   Int          @default(0)
  totalAnswers   Int          @default(0) @map("total_answers")
  helpfulAnswers Int          @default(0) @map("helpful_answers")
  isVerified     Boolean      @default(false) @map("is_verified")
  status         MentorStatus @default(PENDING)
  mentorType     MentorType   @default(STUDENT)
  appliedAt      DateTime     @default(now()) @map("applied_at")
  reviewedAt     DateTime?    @map("reviewed_at")
  user           User         @relation(fields: [userId], references: [id])

  @@map("mentor_profiles")
}

model Conversation {
  id             String    @id @default(uuid())
  participant1Id String    @map("participant1_id")
  participant2Id String    @map("participant2_id")
  itemId         String?   @map("item_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  item           Item?     @relation(fields: [itemId], references: [id])
  participant1   User      @relation("Participant1", fields: [participant1Id], references: [id])
  participant2   User      @relation("Participant2", fields: [participant2Id], references: [id])
  messages       Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  isRead         Boolean      @default(false) @map("is_read")
  sentAt         DateTime     @default(now()) @map("sent_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Question {
  id         String           @id @default(uuid())
  askerId    String           @map("asker_id")
  title      String
  content    String
  category   QuestionCategory
  courseCode String?          @map("course_code")
  status     QuestionStatus   @default(OPEN)
  createdAt  DateTime         @default(now()) @map("created_at")
  answers    Answer[]
  asker      User             @relation(fields: [askerId], references: [id])

  @@map("questions")
}

model Answer {
  id           String   @id @default(uuid())
  questionId   String   @map("question_id")
  mentorId     String   @map("mentor_id")
  content      String
  helpfulCount Int      @default(0) @map("helpful_count")
  isEndorsed   Boolean  @default(false) @map("is_endorsed")
  createdAt    DateTime @default(now()) @map("created_at")
  mentor       User     @relation(fields: [mentorId], references: [id])
  question     Question @relation(fields: [questionId], references: [id])

  @@map("answers")
}

model Review {
  id         String   @id @default(uuid())
  reviewerId String   @map("reviewer_id")
  revieweeId String   @map("reviewee_id")
  itemId     String?  @map("item_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  item       Item?    @relation(fields: [itemId], references: [id])
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])

  @@map("reviews")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  description String?
  link        String?
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")
  user        User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
  @@map("saved_items")
}

model MentorEndorsement {
  id        String   @id @default(uuid())
  mentorId  String   @map("mentor_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([mentorId, userId])
  @@map("mentor_endorsements")
}

enum Category {
  TEXTBOOKS
  ELECTRONICS
  FURNITURE
  CLOTHING
  NOTES
  OTHER
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum QuestionCategory {
  ACADEMIC
  STUDENT_LIFE
  COURSE_ADVICE
  TEXTBOOK_RECOMMENDATION
}

enum QuestionStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum NotificationType {
  MESSAGE
  SALE
  QUESTION
  ANSWER
  ENDORSEMENT
  REVIEW
}

enum MentorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MentorType {
  STUDENT
  ALUMNI
}
